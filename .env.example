# Backend API origin (required when not using localhost:8000)
# Used by Next.js /v1 rewrites, file upload proxy, and SSE passthrough.
API_PROXY_TARGET=http://localhost:8000

# Optional: browser calls backend directly instead of same-origin /v1 proxy.
# Leave empty in dev to use Next rewrites (recommended).
# NEXT_PUBLIC_API_BASE_URL=http://your-backend-host:8000

# Dev presigned upload: auto (default) proxies to backend; on 404 writes to sibling CAN-RAG-BackEnd uploads.
# proxy = backend only | local = disk only
# DEV_UPLOAD_MODE=auto

# Required when DEV_UPLOAD_MODE=local — absolute path to backend upload root
# DEV_UPLOAD_ROOT=/path/to/backend/app/storage/uploads
